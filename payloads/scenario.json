{
  "name": "payment-api memory leak",
  "description": "A codec library upgrade in payment-api v2.14.0 leaks memory. The hung pod starves its Kubernetes node, evicting payments-portal and checkout, and card authorisations back up.",
  "vars": {
    "cluster": "eks-sre-demo",
    "namespace": "payments",
    "node": "ip-10-0-12-34.ap-southeast-2.compute.internal",
    "deployment": "payment-api",
    "claims_service": "payment-api",
    "scheduling_service": "checkout",
    "business_service": "payments-portal",
    "scheduling_tag": "v5.2.0",
    "scheduling_previous_tag": "v5.1.3",
    "scheduling_deployed_ago": "3h",
    "container": "app",
    "image_repo": "registry.internal/payments/payment-api",
    "image_tag": "v2.14.0",
    "previous_tag": "v2.13.4",
    "library": "iso8583-codec",
    "library_from": "3.4.2",
    "library_to": "4.0.0",
    "deployed_ago": "47m",
    "repo_url": "https://github.com/example-payments/payment-api"
  },
  "steps": [
    { "name": "Change event: checkout v5.2.0 (config only, red herring)", "type": "change", "payload": "change-event-checkout.json", "wait_after": "2s" },
    { "name": "Change event: payment-api v2.14.0 rollout (codec library upgrade)", "type": "change", "payload": "change-event.json", "wait_after": "3s" },
    { "name": "Noise: probe latency (info, suppressed by EO)", "type": "alert", "payload": "alerts/00-probe-noise.json", "wait_after": "2s" },
    { "name": "payment-api memory leak, worker hung", "type": "alert", "payload": "alerts/01-claims-memory-leak.json", "wait_after": "3s" },
    { "name": "Splunk: payment-api ISO 8583 decode error spike", "type": "alert", "payload": "alerts/08-claims-error-log-spike.json", "wait_after": "2s" },
    { "name": "checkout latency + readiness failing", "type": "alert", "payload": "alerts/05-checkout-latency.json", "wait_after": "2s" },
    { "name": "RDS: checkout-db read latency", "type": "alert", "payload": "alerts/07-checkout-db-latency.json", "wait_after": "3s" },
    { "name": "Node MemoryPressure, kubelet evicting", "type": "alert", "payload": "alerts/02-node-memory-pressure.json", "wait_after": "2s" },
    { "name": "checkout and payments-portal pods evicted", "type": "alert", "payload": "alerts/03-colocated-pods-evicted.json", "wait_after": "2s" },
    { "name": "checkout 503s at the ingress", "type": "alert", "payload": "alerts/06-checkout-503s.json", "wait_after": "2s" },
    { "name": "Synthetics: complete-a-purchase journey failing", "type": "alert", "payload": "alerts/09-booking-synthetic-failed.json", "wait_after": "3s" },
    { "name": "Card authorisation queue backing up", "type": "alert", "payload": "alerts/04-claims-queue-backlog.json", "wait_after": "2s" },
    { "name": "Acquirer: settlement batch acknowledgements overdue", "type": "alert", "payload": "alerts/10-clearinghouse-ack-delay.json", "wait_after": "0s" }
  ]
}
