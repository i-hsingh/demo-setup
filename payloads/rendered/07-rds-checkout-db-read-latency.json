{
  "client": "Amazon CloudWatch",
  "client_url": "https://console.aws.amazon.com/cloudwatch/home#alarmsV2:",
  "dedup_key": "reinvent/checkout-db/read-latency",
  "event_action": "trigger",
  "payload": {
    "class": "database_latency",
    "component": "checkout-db",
    "custom_details": {
      "alarm": "checkout-db-read-latency-high",
      "connections": "312 of 400 max; retries from checkout pods that keep restarting",
      "cpu": "41% (normal)",
      "engine": "postgres 15.6",
      "note": "Connection churn from checkout restarts, not a database fault.",
      "platform": "aws-rds",
      "read_latency_p99": "180ms (normal 12ms)",
      "service": "checkout"
    },
    "group": "aws-ap-southeast-2",
    "severity": "warning",
    "source": "checkout-db.c9xk2l.ap-southeast-2.rds.amazonaws.com",
    "summary": "RDS checkout-db: ReadLatency 180ms (threshold 50ms), DatabaseConnections 312 of 400"
  },
  "routing_key": "YOUR_ORCHESTRATION_ROUTING_KEY"
}
