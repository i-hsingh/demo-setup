{
  "event_action": "trigger",
  "dedup_key": "reinvent/{{.Vars.namespace}}/checkout-503s",
  "client": "Prometheus Alertmanager ({{.Vars.cluster}})",
  "payload": {
    "summary": "Kubernetes: ingress returning 503 for 38% of {{.Vars.scheduling_service}} requests, 0 ready endpoints; purchases failing in {{.Vars.business_service}}",
    "source": "{{.Vars.node}}",
    "severity": "error",
    "timestamp": "{{now}}",
    "component": "ingress-nginx → {{.Vars.scheduling_service}}",
    "group": "{{.Vars.namespace}}",
    "class": "http_5xx",
    "custom_details": {
      "service": "{{.Vars.scheduling_service}}",
      "platform": "kubernetes",
      "cluster": "{{.Vars.cluster}}",
      "namespace": "{{.Vars.namespace}}",
      "node": "{{.Vars.node}}",
      "error_rate": "38% 503 over 5m (threshold 5%)",
      "ready_endpoints": "0/1 (pod evicted, replacement Pending on memory-pressure taint)",
      "affected_routes": "/api/checkout, /api/cart/confirm",
      "customer_impact": "{{.Vars.business_service}}: customers can't complete purchases",
      "alertname": "IngressHigh5xxRate"
    }
  }
}
