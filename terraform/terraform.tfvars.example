# Optional. Copy to terraform.tfvars (gitignored) only to change the settings below.
# responder_email is asked for by `make plan` / `create` and passed as -var, which wins over this file.
# responder_email = "you@example.com"

# team_id = "PXXXXXX"

# "intelligent" tells the story; "content_based" guarantees one incident on a fresh service.
# alert_grouping_type = "content_based"

# Set false if priorities are not enabled on the sandbox.
# enable_priority = true

# Set false to build all four workflows by hand from templates.
# manage_incident_workflows = true

# Kubernetes workflows. Paste the ID of a Kubernetes Cluster connection
# (Integrations → Workflow Integrations → Kubernetes Clusters) to run their
# output in a pod. Empty: they post the same output as an incident note.
# k8s_connection_id  = ""
# k8s_namespace      = "healthcare"
# k8s_exec_pod       = "claims-toolbox"
# k8s_exec_container = "worker"

# Major Incident opens a Google Chat space ("none" to skip). Set the workspace
# name only if more than one Google Workspace is connected.
# major_incident_conference = "google_chat"
# google_workspace          = ""
